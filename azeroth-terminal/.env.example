# Blizzard Battle.net API credentials
# Register a client at https://develop.battle.net/access/clients to get these.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Optional
PORT=8788
DB_PROVIDER=sqlite
SQLITE_PATH=.data/azeroth-terminal.sqlite
# WoW Token changes every few minutes; the AH snapshot is regenerated ~hourly by
# Blizzard (the proxy checks Last-Modified, so most AH polls are cheap no-ops).
POLL_TOKEN_SEC=300
POLL_AH_SEC=900
# Reserved for future PostgreSQL migration path (not used yet)
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://user:pass@localhost:5432/azeroth
